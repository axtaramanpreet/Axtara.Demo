# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
#
# NEXT_PUBLIC_ is compiled into the browser bundle and visible to anyone who
# loads the page. Only the two Supabase values below may carry that prefix; they
# are safe because row-level security governs what the anon key can reach.
#
# Everything else here is server-only. In particular:
#   - SUPABASE_SERVICE_ROLE_KEY bypasses every RLS policy.
#   - ANTHROPIC_FOUNDRY_KEY bills your Foundry resource.
# Prefixing either with NEXT_PUBLIC_ would ship it to every visitor.

# --- Supabase --------------------------------------------------------------
# Local defaults shown; for the hosted project use Settings > API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by route handlers to freeze snapshots and send notices —
# operations the browser is deliberately not allowed to perform.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (capital call notices) ------------------------------------------
# Server-only. Notices go out as plain text with the PDF attached.
#
# The sending domain is a subdomain of its own, so switching provider means
# repointing its DNS rather than changing the address investors have whitelisted.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Axtara Fund Services <notices@notices.axtara.ai>"
# Replies go to a mailbox that exists; notices@ is a sending address only.
EMAIL_REPLY_TO=admin@axtara.ai

# SAFETY CATCH. While this is set, EVERY notice goes to this one address
# whatever the LP register says, so a test deployment pointed at real investor
# data cannot email a real investor. Clearing it is the deliberate act of
# going live.
EMAIL_OVERRIDE_TO=

# --- Defaults a new, blank call starts with --------------------------------
# The same person signs every call a firm issues, and retyping it each time is
# how it ends up wrong. An uploaded workbook always wins over these.
NOTICE_GP_NAME=
NOTICE_SIGNATORY_NAME=
NOTICE_SIGNATORY_TITLE=

# --- Azure AI Foundry (Ask Axtara) -----------------------------------------
# Server-only. The browser calls our own route handler, never Foundry directly.
# Ask Axtara — Claude on Microsoft Foundry.
# ENDPOINT takes the resource name ("my-resource") or the full URL Azure shows.
# MODEL is optional and defaults to claude-opus-5.
# With these unset the assistant still opens; it says it is not connected.
ANTHROPIC_FOUNDRY_ENDPOINT=
ANTHROPIC_FOUNDRY_KEY=
ANTHROPIC_FOUNDRY_MODEL=
